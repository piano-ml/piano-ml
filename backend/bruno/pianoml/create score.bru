meta {
  name: create score
  type: http
  seq: 10
}

post {
  url: http://localhost:8080/score
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: */*
  Authorization: Bearer {{token}}
}

body:json {
  {
    "mbid": "aee4be66-e41e-40aa-bf24-d407144c504b",
    "title": "Redemption Song",
    "author_id": "ed2ac1e9-d51d-4eff-a2c2-85e81abd6360"
  }
  
}

script:pre-request {
  const token = bru.getEnvVar("token");
}

settings {
  encodeUrl: true
  timeout: 0
}
