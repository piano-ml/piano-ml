delete {
  url: http://localhost:8080/admin/error-report/{{errorReportId}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

docs {
  Admin only: 401 without a token, 403 for a non-admin. 204 even if already gone.
}
