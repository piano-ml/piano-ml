{
  "name": "pianoml-acceptance",
  "private": true,
  "description": "End-to-end acceptance tests (CodeceptJS + Playwright), run against a deployed PianoML site.",
  "type": "module",
  "scripts": {
    "test": "codeceptjs run --steps",
