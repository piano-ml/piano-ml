{
  "name": "piano-ml",
  "version": "2.0.3",
  "scripts": {
    "ng": "ng",
    "start": "BASE_PATH='http://localhost:8080' ng serve --proxy-config proxy.conf.json",
    "start-remote": "BASE_PATH='https://api.pianoml.org' ng serve --host 0.0.0.0",
    "prebuild-common": "npm run generate:api && node scripts/generate-version.js && npm run shaders:manifest && npm run generate:sitemap",
    "build": "ng build --no-prerender",
    "build:prod": "npm run prebuild-common  && ng build --configuration=production --no-prerender",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:api": "openapi-generator-cli generate -i ../openapi/api.yaml -g typescript-angular -o src/app/core/api --additional-properties=ngVersion=17.0.0",
    "prestart": "npm run generate:api",
    "shaders:manifest": "node scripts/generate-shader-manifest.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "shaders:watch": "nodemon --watch src/assets/shader --ext glsl --exec \"npm run shaders:manifest\"",
    "dev": "concurrently \"npm run shaders:watch\" \"npm start\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/platform-browser": "^21.2.8",
    "@angular/platform-browser-dynamic": "^21.2.8",
    "@angular/platform-server": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@angular/ssr": "^21.2.7",
    "@criblinc/docker-names": "^1.2.1",
    "@jesperdj/pianokeys": "github:piano-ml/pianokeys",
    "@ng-icons/bootstrap-icons": "^31.2.0",
    "@ng-icons/core": "^31.2.0",
    "@stringsync/musicxml": "^0.3.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tonejs/midi": "^2.0.28",
    "@types/compression": "^1.8.1",
    "@types/marked": "^5.0.2",
    "@types/webmidi": "^2.1.0",
    "@types/wnumb": "^1.2.3",
    "autoprefixer": "^10.4.21",
    "axios": "^1.7.2",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "flyonui": "^1.3.0",
    "lodash": "^4.17.21",
    "marked": "^16.0.0",
    "midi-writer-js": "^3.1.1",
    "ng-beacon": "^0.1.0",
    "nouislider": "^15.8.1",
    "opensheetmusicdisplay": "1.9.7",
    "postcss": "^8.5.14",
    "rxjs": "~7.8.0",
    "spessasynth_lib": "4.2.10",
    "tailwindcss": "4.2.2",
    "tone": "15.1.22",
    "ts-md5": "^1.3.1",
    "tslib": "^2.3.0",
    "vexflow": "5.0.0",
    "webmidi": "^2.5.3",
    "wnumb": "^1.2.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.8",
    "@netlify/angular-runtime": "^3.0.1",
    "@openapitools/openapi-generator-cli": "^2.21.4",
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.16",
    "@types/node": "22.13.14",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.14",
    "typescript": "~5.9.3"
  }
}
