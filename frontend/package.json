{
  "name": "piano-ml",
  "version": "2.0.3",
  "scripts": {
    "ng": "ng",
    "start": "BASE_PATH='http://localhost:8080' ng serve --proxy-config proxy.conf.json",
    "start-remote": "BASE_PATH='https://api.pianoml.org' ng serve --host 0.0.0.0",
    "prebuild-common": "npm run generate:api && node scripts/generate-version.js && npm run shaders:manifest",
    "build": "ng build --no-prerender",
    "build:prod": "npm run prebuild-common  && ng build --configuration=production --no-prerender",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:api": "openapi-generator-cli generate -i ../openapi/api.yaml -g typescript-angular -o src/app/core/api --additional-properties=ngVersion=17.0.0",
    "prestart": "npm run generate:api",
    "shaders:manifest": "node scripts/generate-shader-manifest.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "shaders:watch": "nodemon --watch src/assets/shader --ext glsl --exec \"npm run shaders:manifest\"",
    "dev": "concurrently \"npm run shaders:watch\" \"npm start\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-browser-dynamic": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/ssr": "22.2.6",
    "@angular/youtube-player": "22.2.6",
    "@criblinc/docker-names": "^1.2.1",
    "@jesperdj/pianokeys": "github:piano-ml/pianokeys",
    "@ng-icons/bootstrap-icons": "^36.1.0",
    "@ng-icons/core": "^36.1.0",
    "@stringsync/musicxml": "^0.3.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tonejs/midi": "^2.0.28",
    "@types/compression": "^1.8.1",
    "@types/marked": "^5.0.2",
    "@types/webmidi": "^2.1.0",
    "@types/wnumb": "^1.2.3",
    "autoprefixer": "^10.4.21",
    "axios": "^1.7.2",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "flyonui": "^1.3.0",
    "lodash": "^4.17.21",
    "marked": "^18.0.4",
    "midi-writer-js": "^3.1.1",
    "ng-beacon": "^0.1.0",
    "nouislider": "^15.8.1",
    "opensheetmusicdisplay": "1.9.7",
    "postcss": "^8.5.14",
    "rxjs": "~7.8.0",
    "spessasynth_lib": "4.4.7",
    "tailwindcss": "4.2.2",
    "tone": "15.1.22",
    "ts-md5": "^1.3.1",
    "tslib": "^2.3.0",
    "vexflow": "5.0.0",
    "webmidi": "^2.5.3",
    "wnumb": "^1.2.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@netlify/angular-runtime": "^3.0.1",
    "@openapitools/openapi-generator-cli": "^2.32.0",
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.17",
    "@types/lodash": "^4.17.27",
    "@types/node": "22.13.14",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.14",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
