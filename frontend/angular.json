{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "piano-ml": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "en",
          "subPath": ""
        },
        "locales": {
          "es": {
            "translation": "src/locale/messages.es.xlf",
            "subPath": "es"
          },
          "fr": {
            "translation": "src/locale/messages.fr.xlf",
            "subPath": "fr"
          },
          "it": {
            "translation": "src/locale/messages.it.xlf",
            "subPath": "it"
          },
          "zh-Hans": {
            "translation": "src/locale/messages.zh-Hans.xlf",
            "subPath": "zh"
          },
          "de": {
            "translation": "src/locale/messages.de.xlf",
            "subPath": "de"
          },
          "nl": {
            "translation": "src/locale/messages.nl.xlf",
            "subPath": "nl"
          },
          "pl": {
            "translation": "src/locale/messages.pl.xlf",
            "subPath": "pl"
          },
          "sv": {
            "translation": "src/locale/messages.sv.xlf",
            "subPath": "sv"
          },
          "th": {
            "translation": "src/locale/messages.th.xlf",
            "subPath": "th"
          },
          "uk": {
            "translation": "src/locale/messages.uk.xlf",
            "subPath": "uk"
          },
          "ko": {
            "translation": "src/locale/messages.ko.xlf",
            "subPath": "ko"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "security": {
              "allowedHosts": [
                "*.run.app",
                "*.pianoml.org",
                "pianoml.org",
                "localhost"
              ]
            },
            "outputMode": "server",
            "i18nMissingTranslation": "error",
            "loader": {
              ".glsl": "text"
            },
            "outputPath": "dist/piano-ml",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets/",
                "output": "/assets/"
              },
              {
                "glob": "sitemap*.{xml,xml.gz}",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "manifest.*.webmanifest",
                "input": "src",
                "output": "/"
              },
              "src/robots.txt"
            ],
            "styles": [
              "./node_modules/nouislider/dist/nouislider.min.css",
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "prerender": false,
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "localize": true,
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": true
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "64kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": false
              }
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "**/*",
                  "input": "src/assets",
                  "output": "/assets"
                }
              ],
              "styles": [
                "src/styles.css"
              ],
              "scripts": [],
              "polyfills": [
                "zone.js",
                "zone.js/testing",
                "@angular/localize/init"
              ]
            },
            "es": {
              "localize": [
                "es"
              ],
              "baseHref": "/es/"
            },
            "fr": {
              "localize": [
                "fr"
              ],
              "baseHref": "/fr/"
            },
            "it": {
              "localize": [
                "it"
              ],
              "baseHref": "/it/"
            },
            "zh-Hans": {
              "localize": [
                "zh-Hans"
              ],
              "baseHref": "/zh/"
            },
            "de": {
              "localize": [
                "de"
              ],
              "baseHref": "/de/"
            },
            "nl": {
              "localize": [
                "nl"
              ],
              "baseHref": "/nl/"
            },
            "pl": {
              "localize": [
                "pl"
              ],
              "baseHref": "/pl/"
            },
            "sv": {
              "localize": [
                "sv"
              ],
              "baseHref": "/sv/"
            },
            "th": {
              "localize": [
                "th"
              ],
              "baseHref": "/th/"
            },
            "uk": {
              "localize": [
                "uk"
              ],
              "baseHref": "/uk/"
            },
            "ko": {
              "localize": [
                "ko"
              ],
              "baseHref": "/ko/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "piano-ml:build:production"
            },
            "development": {
              "buildTarget": "piano-ml:build:development",
              "proxyConfig": "proxy.conf.mjs"
            },
            "es": {
              "buildTarget": "piano-ml:build:development,es",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/es/"
            },
            "fr": {
              "buildTarget": "piano-ml:build:development,fr",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/fr/"
            },
            "it": {
              "buildTarget": "piano-ml:build:development,it",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/it/"
            },
            "zh-Hans": {
              "buildTarget": "piano-ml:build:development,zh-Hans",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/zh/"
            },
            "de": {
              "buildTarget": "piano-ml:build:development,de",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/de/"
            },
            "nl": {
              "buildTarget": "piano-ml:build:development,nl",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/nl/"
            },
            "pl": {
              "buildTarget": "piano-ml:build:development,pl",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/pl/"
            },
            "sv": {
              "buildTarget": "piano-ml:build:development,sv",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/sv/"
            },
            "th": {
              "buildTarget": "piano-ml:build:development,th",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/th/"
            },
            "uk": {
              "buildTarget": "piano-ml:build:development,uk",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/uk/"
            },
            "ko": {
              "buildTarget": "piano-ml:build:development,ko",
              "proxyConfig": "proxy.conf.mjs",
              "servePath": "/ko/"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": ":build:testing",
            "runner": "vitest",
            "browsers": [
              "ChromiumHeadless"
            ],
            "runnerConfig": true,
            "coverageReporters": [
              "json-summary",
              "json",
              "html",
              "text-summary"
            ],
            "coverageExclude": [
              "src/app/core/api/**"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false
  }
}
